# ============================================
# SentinelX Environment Configuration
# ============================================
# Copy this file to .env and adjust values

# --- VulnBank (Target API) ---
VULNBANK_SECURE_MODE=false

# --- SentinelX Backend ---
DATABASE_URL=sqlite:///./data/sentinelx.db
ALLOWED_TARGETS=vulnerable-api,localhost,127.0.0.1
LOG_LEVEL=INFO
MAX_REQUESTS_PER_SCAN=1000
REQUEST_TIMEOUT=10.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- SentinelX Frontend ---
VITE_API_URL=http://localhost:8000
